        "#bar chart filtered (2000-2017)\n",
        "\n",
        "df[\"release_date\"] = pd.to_datetime(df[\"release_date\"], errors=\"coerce\")\n",
        "df[\"release_year\"] = df[\"release_date\"].dt.year\n",
        "\n",
        "#filter to 2000–2017\n",
        "df_2000_2017 = df[df[\"release_year\"].between(2000, 2017)].copy()\n",
        "\n",
        "#split + explode production_companies ONLY within filtered df\n",
        "split_companies = df_2000_2017[\"production_companies\"].dropna().str.split(\"|\")\n",
        "exploded = split_companies.explode().str.strip()\n",
        "exploded = exploded[exploded != \"\"]  # optional: remove empty strings\n",
        "\n",
        "company_counts = exploded.value_counts()\n",
        "\n",
        "top30_companies = company_counts.head(30)\n",
        "\n",
        "highlight = ['Walt Disney Pictures', 'Warner Bros. Pictures', 'Paramount', 'Walt Disney Productions', 'Universal Pictures', '20th Century Fox', 'Universal International Pictures (UI)',\"Touchstone Pictures\", \"Hollywood Pictures\", \"Walt Disney Animation Studios\", \"Miramax Films\", \"Disneynature\", \"DisneyToon Studios\", \"New Line Cinema\", \"Castle Rock Entertainment\", \"Warner Bros. Animation\", \"Fine Line Features\", \"Picturehouse\", \"MTV Films\", \"Nickelodeon Movies\", \"Comedy Central Films\", \"Paramount Vantage\", \"DreamWorks Pictures\", \"Focus Features\", \"Rogue Pictures\", \"Gramercy Pictures\", \"Working Title Films\", \"Universal Animation Studios\", \"Illumination Entertainment\", \"Fox Searchlight Pictures\", \"Fox 2000 Pictures\", \"Fox Animation Studios\", \"20th Century Fox Animation\", \"Blue Sky Studios\", \"Fox Atomic\", \"Fox International Productions\"]\n",
