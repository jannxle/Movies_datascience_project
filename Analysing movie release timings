        "print(f\"  - competitor_count (continuous)\")\n",
        "print(f\"  - is_major_int (binary: 0/1)\")\n",
        "print(f\"  - Season dummies (reference: Off-Peak): {season_cols}\")\n",
        "\n",
        "# Build and fit model\n",
        "feature_cols = ['weighted_rating', 'faced_major_int', 'competitor_count',\n",
        "                'is_major_int'] + season_cols\n",
        "X = sm.add_constant(reg_df[feature_cols])\n",
        "y = reg_df['log_revenue']\n",
        "\n",
        "model = sm.OLS(y, X).fit()\n",
        "print(\"\\n=== OLS REGRESSION RESULTS ===\")\n",
        "print(model.summary())\n",
        "\n",
        "# Coefficient Plot\n",
        "fig, ax = plt.subplots(figsize=(10, 6))\n",
        "\n",
        "coef = model.params.drop('const')\n",
        "ci = model.conf_int().drop('const')\n",
