        "## <font color = #6d9eeb>**Profiling of Datasets 1 & 2 to Check Naming Conventions**"
      ],
      "metadata": {
        "id": "82_wABNXhrnx"
      }
    },
    {
      "cell_type": "markdown",
      "source": [
        "Before integrating the two datasets based on film title and release year, we use fuzzy match to check if different naming conventions result in the same film having different titles in the two datasets."
      ],
      "metadata": {
        "id": "VS2ZOMuTh2Vv"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# standardise movie titles (lowercase, strip spaces, remove punctuation)\n",
        "def clean_title(title):\n",
        "    if pd.isna(title):\n",
        "        return title\n",
        "    title = str(title).lower().strip()\n",
        "    return re.sub(r'[^\\w\\s]', '', title)\n",
        "\n",
        "ds1['title_clean'] = ds1['title'].apply(clean_title)\n",
        "ds2['title_clean'] = ds2['title'].apply(clean_title)\n",
        "\n",
        "# perform an outer join to see what matches and what gets left behind\n",
        "merge_check = pd.merge(ds1, ds2, on=[\"title_clean\", \"year\"], how=\"outer\", indicator=True)\n",
        "\n",
        "# 5. filter for movies that DID NOT match\n",
        "unmatched = merge_check[merge_check['_merge'] != 'both']\n",
        "\n",
        "print(f\"Total unmatched rows: {len(unmatched)}\")\n",
        "print(merge_check['_merge'].value_counts())\n",
        "\n",
        "# sort by release date to spot naming convention differences side-by-side\n",
        "unmatched_sorted = unmatched.sort_values(by='year')\n",
        "\n",
        "pd.set_option('display.max_rows', 100)\n",
        "\n",
        "# display the sorted mismatches (title_x comes from ds1, title_y comes from ds2)\n",
        "display(unmatched_sorted[['title_x', 'title_y', 'year', '_merge']].head(100))"
      ],
