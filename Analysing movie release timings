    {
      "cell_type": "code",
      "source": [
        "ds3['title'] = ds3['title'].replace(\"Love Don't Co$t a Thing\", \"Love Don't Cost a Thing\")"
      ],
      "metadata": {
        "id": "i53zV8lRoT1z"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "df['title_clean'] = df['title'].apply(clean_title)\n",
        "ds3['title_clean'] = ds3['title'].apply(clean_title)\n",
        "\n",
        "# perform an outer join to see what matches and what gets left behind\n",
        "merge_check = pd.merge(df, ds3, on=[\"title_clean\", \"release_date\"], how=\"outer\", indicator=True)\n",
        "\n",
        "# 5. filter for movies that DID NOT match\n",
        "unmatched = merge_check[merge_check['_merge'] != 'both']\n",
        "\n",
        "print(f\"Total unmatched rows: {len(unmatched)}\")\n",
        "print(merge_check['_merge'].value_counts())\n",
        "\n",
        "# sort by release date to spot naming convention differences side-by-side\n",
        "unmatched_sorted = unmatched.sort_values(by='release_date')\n",
        "\n",
        "pd.set_option('display.max_rows', 100)\n",
        "\n",
        "df_orphans = unmatched[unmatched['_merge'] == 'left_only'].copy()\n",
        "ds3_orphans = unmatched[unmatched['_merge'] == 'right_only'].copy()\n",
        "\n",
        "# merge these orphans based strictly on release_date\n",
        "suspected_matches = pd.merge(df_orphans, ds3_orphans, on='release_date', suffixes=('_df', '_ds3'))\n",
        "\n",
        "# define a function to score string similarity (0.0 to 1.0)\n",
        "def get_similarity(title1, title2):\n",
        "    if pd.isna(title1) or pd.isna(title2):\n",
        "        return 0\n",
        "    return difflib.SequenceMatcher(None, str(title1), str(title2)).ratio()\n",
        "\n",
        "# calculate a similarity score for every pair that shares a release date\n",
        "suspected_matches['similarity_score'] = suspected_matches.apply(\n",
        "    lambda row: get_similarity(row['title_x_df'], row['title_y_ds3']), axis=1\n",
        ")\n",
        "\n",
        "# filter to only show pairs where the titles are at least 60% similar\n",
        "high_probability_matches = suspected_matches[suspected_matches['similarity_score'] > 0.60]\n",
        "\n",
        "# display the automated matches, sorted by most similar first\n",
        "display(high_probability_matches[['title_x_df', 'title_y_ds3', 'release_date', 'similarity_score']].sort_values(by='similarity_score', ascending=False))"
