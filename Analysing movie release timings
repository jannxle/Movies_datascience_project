    {
      "cell_type": "code",
      "source": [
        "\n",
        "# Prepare regression dataframe\n",
        "reg_df = df[['box_office_revenue', 'weighted_rating', 'faced_major_studio',\n",
        "             'competitor_count', 'season', 'is_major_studio']].dropna().copy()\n",
        "\n",
        "# Log transform revenue (as established in earlier steps, revenue is right-skewed)\n",
        "reg_df = reg_df[reg_df['box_office_revenue'] > 0]\n",
        "reg_df['log_revenue'] = np.log(reg_df['box_office_revenue'])\n",
        "\n",
        "# Encode binary variables as integers\n",
        "reg_df['faced_major_int'] = reg_df['faced_major_studio'].astype(int)\n",
        "reg_df['is_major_int'] = reg_df['is_major_studio'].astype(int)\n",
        "\n",
        "# Encode season as dummy variables (Off-Peak as reference/baseline)\n",
        "season_dummies = pd.get_dummies(reg_df['season'], drop_first=False, dtype=int)\n",
        "season_dummies = season_dummies.drop(columns=['Off-Peak (Jan–Feb, Sep–Oct)'])  # reference category\n",
        "reg_df = pd.concat([reg_df, season_dummies], axis=1)\n",
        "\n",
        "season_cols = [col for col in season_dummies.columns]\n",
        "\n",
        "print(\"=== REGRESSION DATASET SUMMARY ===\")\n",
        "print(f\"Total observations: {len(reg_df)}\")\n",
        "print(f\"\\nFeatures used:\")\n",
        "print(f\"  - weighted_rating (continuous)\")\n",
