      "cell_type": "markdown",
      "source": [
        "##<font color = #6d9eeb> **Enriching Unified Dataset**"
      ],
      "metadata": {
        "id": "Dzq9qcW0VpdB"
      }
    },
    {
      "cell_type": "markdown",
      "source": [
        "In this section, we engineer new features to quantify the competitive environment for each movie. We use a 14-day release window to calculate how many total films, and specifically how many major studio films, were released around the same time.\n",
        "\n"
      ],
      "metadata": {
        "id": "XQB9pF3-WSsl"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# identify Major Studios and their key subsidiary companies\n",
        "big_six = ['Walt Disney Pictures', 'Warner Bros.', 'Paramount Pictures', 'Sony Pictures Entertainment', 'Walt Disney Productions', 'Universal Pictures', 'Twentieth Century Fox Film Corporation', 'Universal International Pictures (UI)', \"Touchstone Pictures\", \"Hollywood Pictures\", \"Walt Disney Animation Studios\", \"Miramax Films\", \"Disneynature\", \"DisneyToon Studios\", \"New Line Cinema\", \"Castle Rock Entertainment\", \"Warner Bros. Animation\", \"Fine Line Features\", \"Picturehouse\", \"MTV Films\", \"Nickelodeon Movies\", \"Comedy Central Films\", \"Paramount Vantage\", \"DreamWorks Pictures\", \"Focus Features\", \"Rogue Pictures\", \"Gramercy Pictures\", \"Working Title Films\", \"Universal Animation Studios\", \"Illumination Entertainment\", \"Fox Searchlight Pictures\", \"Fox 2000 Pictures\", \"Fox Animation Studios\", \"20th Century Fox Animation\", \"Blue Sky Studios\", \"Fox Atomic\", \"Fox International Productions\"]\n",
        "pattern = '|'.join(big_six)\n",
        "df['is_major_studio'] = df['production_companies'].fillna('').str.contains(pattern, case=False, regex=True)\n",
        "\n",
        "# sort by date\n",
        "df['release_date'] = pd.to_datetime(df['release_date'])\n",
        "df = df.sort_values('release_date').reset_index(drop=True)\n",
        "\n",
        "# create empty lists to store our new metrics\n",
        "competition_counts = []\n",
        "major_competitor_counts = []\n",
        "has_major_competitor = []\n",
        "\n",
        "# loop through each movie to check its window\n",
        "for index, row in df.iterrows():\n",
        "    start_date = row['release_date'] - pd.Timedelta(days=7)\n",
        "    end_date = row['release_date'] + pd.Timedelta(days=7)\n",
        "\n",
        "    # get all OTHER movies in this window\n",
        "    competitors = df[(df['release_date'] >= start_date) &\n",
        "                     (df['release_date'] <= end_date) &\n",
        "                     (df.index != index)]\n",
        "\n",
        "    # metric A: Total number of competitors\n",
        "    total_comp = len(competitors)\n",
        "    competition_counts.append(total_comp)\n",
        "\n",
        "    # metric B: How many of those competitors are MAJOR studios?\n",
        "    major_comp = competitors['is_major_studio'].sum()\n",
        "    major_competitor_counts.append(major_comp)\n",
        "\n",
        "    # metric C: Simple Yes/No - did they face AT LEAST ONE major studio?\n",
        "    has_major_competitor.append(major_comp > 0)\n",
        "\n",
        "# add the lists back to dataframe as new columns\n",
        "df['competitor_count'] = competition_counts\n",
        "df['major_competitor_count'] = major_competitor_counts\n",
        "df['faced_major_studio'] = has_major_competitor"
      ],
