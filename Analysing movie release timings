        "print(f\"  Mean:   ${faced_major.mean():,.0f}\")\n",
        "\n",
        "print(f\"\\nFilms that DID NOT face a major studio (n={len(safe_window)}):\")\n",
        "print(f\"  Median: ${safe_window.median():,.0f}\")\n",
        "print(f\"  Mean:   ${safe_window.mean():,.0f}\")\n",
        "\n",
        "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
        "\n",
        "# Box plot\n",
        "axes[0].boxplot([safe_window.dropna(), faced_major.dropna()],\n",
        "                tick_labels=['Safe Window', 'Faced Major Studio'],\n",
