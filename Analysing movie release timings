        "def run_mannwhitney(data, group_col, value_col, tier_col, label):\n",
        "    WIDTH = 85\n",
        "\n",
        "    print(\"\\n\" + \"=\" * WIDTH)\n",
        "    print(f\"  MANN-WHITNEY U TEST: {label}\")\n",
        "    print(\"=\" * WIDTH)\n",
        "    print(f\"  {'TIER':<16} {'N(safe)':>7} {'N(comp)':>7} {'MED(SAFE)':>16} {'MED(COMP)':>16} {'U-STAT':>8} {'P-VALUE':>8}  {'RESULT'}\")\n",
        "    print(\"-\" * WIDTH)\n",
        "\n",
        "    for tier in data[tier_col].cat.categories:\n",
        "        tier_data = data[data[tier_col] == tier]\n",
        "        g1 = tier_data[tier_data[group_col] == False][value_col].dropna()\n",
        "        g2 = tier_data[tier_data[group_col] == True][value_col].dropna()\n",
        "\n",
        "        if len(g1) < 5 or len(g2) < 5:\n",
        "            print(f\"  {str(tier):<16}  skipped (n={len(g1)}/{len(g2)}, too few samples)\")\n",
        "            continue\n",
        "\n",
        "        stat, p = mannwhitneyu(g1, g2, alternative='two-sided')\n",
        "        sig = \"[SIG]\" if p < 0.05 else \"[n.s.]\"\n",
        "\n",
        "        med_safe  = f\"${g1.median():>13,.0f}\"\n",
        "        med_comp  = f\"${g2.median():>13,.0f}\"\n",
        "\n",
        "        print(\n",
        "            f\"  {str(tier):<16}\"\n",
        "            f\" {len(g1):>7}\"\n",
        "            f\" {len(g2):>7}\"\n",
        "            f\" {med_safe:>16}\"\n",
        "            f\" {med_comp:>16}\"\n",
        "            f\" {stat:>8.1f}\"\n",
        "            f\" {p:>8.4f}\"\n",
        "            f\"  {sig}\"\n",
        "        )\n",
        "\n",
        "    print(\"=\" * WIDTH)\n",
        "\n",
        "run_mannwhitney(df, 'faced_major_studio', 'box_office_revenue', 'rating_tier', 'ALL FILMS')\n",
        "run_mannwhitney(df[df['is_major_studio'] == False], 'faced_major_studio',\n",
